# Font
#font-family = Azeret Mono
#font-variation = wght=600
#font-variation-bold = wght=800
#font-variation-italic = wght=600
#font-variation-bold-italic = wght=800
font-size = 16

# Text visibility over transparent background
font-thicken = true
#font-thicken-strength = 100

# Background transparency — only affects background fill, text stays fully opaque
# Was 0.1 in Alacritty (nearly invisible); raise toward 1.0 for less transparency
background-opacity = .6
#background-opacity = 1
#background-opacity-cells = true
macos-titlebar-style = transparent

# Colors — Rosé Pine (main), matches Obsidian theme
background = 1f1d2e
foreground = f8f8f2

# Cursor
cursor-color = f8f8f2
cursor-text = 1f1d2e

# Selection
selection-background = 403d52
selection-foreground = f8f8f2

# Normal colors (0-7)
